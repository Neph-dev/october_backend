{
    "family": "october-backend",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "october-backend",
            "image": "YOUR_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/october-backend:latest",
            "portMappings": [
                {
                    "containerPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "SERVER_HOST",
                    "value": "0.0.0.0"
                },
                {
                    "name": "SERVER_PORT",
                    "value": "8080"
                },
                {
                    "name": "LOG_LEVEL",
                    "value": "info"
                }
            ],
            "secrets": [
                {
                    "name": "DATABASE_URI",
                    "valueFrom": "/october/DATABASE_URI"
                },
                {
                    "name": "OPENAI_API_KEY",
                    "valueFrom": "/october/OPENAI_API_KEY"
                },
                {
                    "name": "CUSTOM_SEARCH_API_KEY",
                    "valueFrom": "/october/CUSTOM_SEARCH_API_KEY"
                },
                {
                    "name": "CUSTOM_SEARCH_ENGINE_ID",
                    "valueFrom": "/october/CUSTOM_SEARCH_ENGINE_ID"
                },
                {
                    "name": "FINNHUB_API_KEY",
                    "valueFrom": "/october/FINNHUB_API_KEY"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/october-backend",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}