# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s

# Database Configuration
DATABASE_URI=mongodb://localhost:27017/october

# AWS Configuration (Set your actual keys here for local development)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Logger Configuration
LOG_LEVEL=info

OPENAI_API_KEY=your_openai_api_key_here

CUSTOM_SEARCH_API_KEY=your_custom_search_api_key_here
CUSTOM_SEARCH_ENGINE_ID=your_custom_search_engine_id_here

FINNHUB_API_KEY=your_finnhub_api_key_here

# Instructions:
# 1. Copy this file to .env.local
# 2. Uncomment and set your actual API keys in .env.local
# 3. Add .env.local to .gitignore to keep it private